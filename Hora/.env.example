# PocketBase server URL — safe to expose (it's just an address, not a secret)
# Local dev default: http://127.0.0.1:8090
# Set this in Vercel env vars for production
VITE_PB_URL=http://127.0.0.1:8090

# DO NOT add admin/service-account credentials here.
# VITE_* vars are compiled into the public JS bundle.
# Admin auth must live in the Go backend only.
# PocketBase credentials (an email, a password, a token) must NEVER use a VITE_ prefix:
# Vite inlines every VITE_* value into the JavaScript it ships, so anyone can read it
# from the public bundle. VITE_PB_EMAIL / VITE_PB_PASSWORD did exactly that until 2026-03.

{
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://my-hora.com/$1",
      "permanent": true,
      "has": [{ "type": "host", "value": "horaapp.co" }]
    },
    {
      "source": "/(.*)",
      "destination": "https://my-hora.com/$1",
      "permanent": true,
      "has": [{ "type": "host", "value": "www.horaapp.co" }]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}